> let arr = [|'a' .. 'g'|];;
val arr: char array = [|'a'; 'b'; 'c'; 'd'; 'e'; 'f'; 'g'|]

> arr[0];;
val it: char = 'a'

> arr[3];;
val it: char = 'd'

> arr[3..];;
val it: char array = [|'d'; 'e'; 'f'; 'g'|]

> arr[..3];;
val it: char array = [|'a'; 'b'; 'c'; 'd'|]

> arr[1..3];;
val it: char array = [|'b'; 'c'; 'd'|]

> arr[*];;
val it: char array = [|'a'; 'b'; 'c'; 'd'; 'e'; 'f'; 'g'|]
